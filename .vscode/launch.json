{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Pipeline (data1.csv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_pipeline.py",
            "args": [
                "--input",
                "data/raw/data1.csv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Pipeline (data2.csv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_pipeline.py",
            "args": [
                "--input",
                "data/raw/data2.csv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run 3-Vehicle Pipeline (2W / 3W / 4W)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_pipeline.py",
            "args": [
                "--input",
                "data/raw/2W_Bike.csv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Pipeline (Hyderabad Dataset)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_pipeline.py",
            "args": [
                "--input",
                "data/raw/hyderabad_dataset.csv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Pipeline (Default Dataset)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_pipeline.py",
            "args": [
                "--input",
                "data/raw/dataset.csv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Start FastAPI API Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.api.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
